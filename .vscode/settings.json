{
    // =====================================
    //  CMAKE TOOLS — presets only
    // =====================================
    "cmake.copyCompileCommands": "${workspaceFolder}/build/compile_commands.json",
    "cmake.useCMakePresets": "always",
    "cmake.configureOnOpen": false,
    "cmake.options.statusBarVisibility": "visible",
    "cmake.buildDirectory": "${workspaceFolder}/build",
    "cmake.preferredGenerators": [
        "Ninja",
    ],
    // =====================================
    // Microsoft C++ IntelliSense (cpptools)
    // Keep for debugging / CMake integration, but disable IntelliSense + analysis
    // =====================================
    "C_Cpp.autocomplete": "disabled",
    "C_Cpp.errorSquiggles": "disabled",
    "C_Cpp.intelliSenseEngine": "disabled",
    // Disable clang-tidy completely in MS C++ extension
    "C_Cpp.codeAnalysis.clangTidy.enabled": false,
    "C_Cpp.codeAnalysis.runAutomatically": false,
    "C_Cpp.codeAnalysis.updateDelay": 0,
    // =====================================
    // Clangd (LLVM) integration
    // IntelliSense
    // =====================================
    "clangd.arguments": [
        "--completion-style=detailed",
        "--clang-tidy",
        "--log=error"
    ],
    // =====================================
    // File Associations
    // =====================================
    "files.associations": {
        "*.h": "cpp",
        "*.hpp": "cpp",
        "*.ipp": "cpp",
        ".clang-tidy": "yaml",
        ".clangd": "yaml",
    },
    // =====================================
    // Formatting (clang-format)
    // =====================================
    "clang-format.style": "file",
    "editor.formatOnSave": true,
    "editor.rulers": [
        100
    ],
    "[cpp]": {
        "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd",
        "editor.formatOnSave": true,
        "editor.formatOnType": true
    },
    "[c]": {
        "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd",
        "editor.formatOnSave": true,
        "editor.formatOnType": true
    },
    "cSpell.words": [
        "ARGN",
        "BINDIR",
        "ctest",
        "DATAROOTDIR",
        "DDEMOLIB",
        "DEMOLIB",
        "endfunction",
        "endmacro",
        "fcoverage",
        "fprofile",
        "fsanitize",
        "INCLUDEDIR",
        "mklink",
        "msvc",
        "MSYS",
        "regentsburgess",
        "someheader",
        "STREQUAL",
        "Wextra",
        "Wpedantic"
    ]
}