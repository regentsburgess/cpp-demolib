{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 30
  },
  "include": [
    "os-base.json"
  ],
  "configurePresets": [
    {
      "name": "linux-config-base",
      "hidden": true,
      "inherits": "os-base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {}
    },
    {
      "name": "linux-config-debug",
      "displayName": "Linux Debug Config Preset",
      "inherits": "linux-config-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "linux-config-release",
      "displayName": "Linux Release Config Preset",
      "inherits": "linux-config-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "linux-build-debug",
      "displayName": "Linux Debug Build Preset",
      "configurePreset": "linux-config-debug"
    },
    {
      "name": "linux-build-release",
      "displayName": "Linux Release Build Preset",
      "configurePreset": "linux-config-release"
    },
    {
      "name": "linux-install-debug",
      "displayName": "Linux Debug Build and Install Preset",
      "configurePreset": "linux-config-debug",
      "targets": [
        "install"
      ]
    },
    {
      "name": "linux-install-release",
      "displayName": "Linux Release Build and Install Preset",
      "configurePreset": "linux-config-release",
      "targets": [
        "install"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "linux-test-debug",
      "displayName": "Linux Debug Test Preset",
      "configurePreset": "linux-config-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-test-release",
      "displayName": "Linux Debug Release Preset",
      "configurePreset": "linux-config-release",
      "output": {
        "outputOnFailure": true
      }
    }
  ],
  "workflowPresets": [
    {
      "name": "linux-build-debug",
      "displayName": "Linux Debug Configure and Build Workflow Preset",
      "steps": [
        {
          "type": "configure",
          "name": "linux-config-debug"
        },
        {
          "type": "build",
          "name": "linux-build-debug"
        }
      ]
    },
    {
      "name": "linux-build-release",
      "displayName": "Linux Release Configure and Build Workflow Preset",
      "steps": [
        {
          "type": "configure",
          "name": "linux-config-release"
        },
        {
          "type": "build",
          "name": "linux-build-release"
        }
      ]
    },
    {
      "name": "linux-test-debug",
      "displayName": "Linux Debug Configure, Build, and Test Workflow Preset",
      "steps": [
        {
          "type": "configure",
          "name": "linux-config-debug"
        },
        {
          "type": "build",
          "name": "linux-build-debug"
        },
        {
          "type": "test",
          "name": "linux-test-debug"
        }
      ]
    },
    {
      "name": "linux-test-release",
      "displayName": "Linux Release Configure, Build, and Test Workflow Preset",
      "steps": [
        {
          "type": "configure",
          "name": "linux-release"
        },
        {
          "type": "build",
          "name": "linux-release"
        },
        {
          "type": "test",
          "name": "linux-release-test"
        }
      ]
    }
  ]
}