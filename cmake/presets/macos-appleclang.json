{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 30
  },
  "include": [
    "os-base.json"
  ],
  "configurePresets": [
    {
      "name": "macos-appleclang-config-base",
      "hidden": true,
      "inherits": "os-base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "/usr/bin/clang",
        "CMAKE_CXX_COMPILER": "/usr/bin/clang++",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "DEMOLIB_CLANG_TIDY_WARNINGS_AS_ERRORS": "ON",
        "DEMOLIB_CLANG_TIDY_ENABLE": "ON"
      }
    },
    {
      "name": "macos-appleclang-config-debug",
      "displayName": "macOS Debug Config Preset",
      "inherits": "macos-appleclang-config-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "macos-appleclang-config-release",
      "displayName": "macOS Release Config Preset",
      "inherits": "macos-appleclang-config-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "macos-appleclang-build-debug",
      "displayName": "macOS Debug Build Preset",
      "configurePreset": "macos-appleclang-config-debug"
    },
    {
      "name": "macos-appleclang-build-release",
      "displayName": "macOS Release Build Preset",
      "configurePreset": "macos-appleclang-config-release"
    },
    {
      "name": "macos-appleclang-install-debug",
      "displayName": "macOS Debug Build and Install Preset",
      "configurePreset": "macos-appleclang-config-debug",
      "targets": [
        "install"
      ]
    },
    {
      "name": "macos-appleclang-install-release",
      "displayName": "macOS Release Build and Install Preset",
      "configurePreset": "macos-appleclang-config-release",
      "targets": [
        "install"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "macos-appleclang-test-debug",
      "displayName": "macOS Debug Test Preset",
      "configurePreset": "macos-appleclang-config-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "macos-appleclang-test-release",
      "displayName": "macOS Release Test Preset",
      "configurePreset": "macos-appleclang-config-release",
      "output": {
        "outputOnFailure": true
      }
    }
  ],
  "workflowPresets": [
    {
      "name": "macos-appleclang-test-debug",
      "displayName": "macOS Debug Configure, Build, and Test Workflow Preset",
      "steps": [
        {
          "type": "configure",
          "name": "macos-appleclang-config-debug"
        },
        {
          "type": "build",
          "name": "macos-appleclang-build-debug"
        },
        {
          "type": "test",
          "name": "macos-appleclang-test-debug"
        }
      ]
    },
    {
      "name": "macos-appleclang-test-release",
      "displayName": "macOS Release Configure, Build, and Test Workflow Preset",
      "steps": [
        {
          "type": "configure",
          "name": "macos-appleclang-config-release"
        },
        {
          "type": "build",
          "name": "macos-appleclang-build-release"
        },
        {
          "type": "test",
          "name": "macos-appleclang-test-release"
        }
      ]
    }
  ]
}