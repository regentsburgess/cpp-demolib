{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 30
  },
  "configurePresets": [
    {
      "name": "os-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "installDir": "${sourceDir}/build/${presetName}/stage",
      "cacheVariables": {
        "CMAKE_CXX_SCAN_FOR_MODULES": "OFF",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "OFF",
        "DEMOLIB_CLANG_TIDY_ENABLE": "OFF",
        "DEMOLIB_CLANG_TIDY_WARNINGS_AS_ERRORS": "OFF",
        "DEMOLIB_CLANG_SANITIZERS_ENABLE": "OFF",
        "DEMOLIB_COVERAGE_ENABLE": "OFF"
      }
    }
  ]
}