{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 30
  },
  "include": [
    "os-base.json"
  ],
  "configurePresets": [
    {
      "name": "windows-config-base",
      "hidden": true,
      "inherits": "os-base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {}
    },
    {
      "name": "windows-config-debug",
      "displayName": "Windows Debug Config Preset",
      "inherits": "windows-config-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "windows-config-release",
      "displayName": "Windows Release Config Preset",
      "inherits": "windows-config-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-build-debug",
      "displayName": "Windows Debug Build Preset",
      "configurePreset": "windows-config-debug"
    },
    {
      "name": "windows-build-release",
      "displayName": "Windows Release Build Preset",
      "configurePreset": "windows-config-release"
    },
    {
      "name": "windows-install-debug",
      "displayName": "Windows Debug Build and Install Preset",
      "configurePreset": "windows-config-debug",
      "targets": [
        "install"
      ]
    },
    {
      "name": "windows-install-release",
      "displayName": "Windows Release Build and Install Preset",
      "configurePreset": "windows-config-release",
      "targets": [
        "install"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "windows-test-debug",
      "displayName": "Windows Debug Test Preset",
      "configurePreset": "windows-config-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-test-release",
      "displayName": "Windows Release Test Preset",
      "configurePreset": "windows-config-release",
      "output": {
        "outputOnFailure": true
      }
    }
  ],
  "workflowPresets": [
    {
      "name": "windows-test-debug",
      "displayName": "Windows Debug Configure, Build, and Test Workflow Preset",
      "steps": [
        {
          "type": "configure",
          "name": "windows-config-debug"
        },
        {
          "type": "build",
          "name": "windows-build-debug"
        },
        {
          "type": "test",
          "name": "windows-test-debug"
        }
      ]
    },
    {
      "name": "windows-test-release",
      "displayName": "Windows Release Configure, Build, and Test Workflow Preset",
      "steps": [
        {
          "type": "configure",
          "name": "windows-config-release"
        },
        {
          "type": "build",
          "name": "windows-build-release"
        },
        {
          "type": "test",
          "name": "windows-test-release"
        }
      ]
    }
  ]
}